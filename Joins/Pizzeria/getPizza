-- 19. Geben Sie alle Standorte mit Standortname sowie den angebotenen Pizzen aus. Auch
-- Standorte ohne Eintrag in der Speisekarte sollen angezeigt werden.
SELECT Standort.sName, Pizza.pName FROM Standort
LEFT JOIN Speissekarte ON Standort.SID = Speissekarte.sID
LEFT JOIN Pizza ON Speissekarte.pID = Pizza.PID;
       
-- 20. Geben Sie alle Standorte mit Standortname aus, zu denen kein Eintrag in der Speise-
-- karte existiert
SELECT Standort.sName, Pizza.pName FROM Standort
LEFT JOIN Speissekarte ON Standort.SID = Speissekarte.sID
LEFT JOIN Pizza ON Speissekarte.pID = Pizza.PID
WHERE Speissekarte.SID = 0;
 
-- 21. Geben Sie alle Pizzen mit Pizzaname sowie den dazugehörigen Standorten aus. Auch
-- Pizzen, die an keinem Standort angeboten werden, sollen angezeigt werden
SELECT Standort.sName, Pizza.pName FROM Standort 
RIGHT JOIN Speissekarte ON Standort.SID = Speissekarte.sID
RIGHT JOIN Pizza ON Speissekarte.pID = Pizza.PID;
-- 22. Geben Sie alle Pizzen mit Pizzaname aus, die an keinem Standort angeboten werden.
SELECT Pizza.pName FROM Pizza    	
LEFT JOIN Speissekarte ON Pizza.PID = Speissekarte.pID;

