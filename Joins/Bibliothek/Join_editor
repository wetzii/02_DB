FROM Autor
INNER JOIN Buch ON Autor.AID = Buch.aID;

--17. Geben Sie alle verfügbaren Exemplare mit Buchtitel und Standort, absteigend sortiert
--nach Standort aus.
SELECT buch.bTitle, Exemplar.eStandort, Exemplar.eStatus
FROM Exemplar 
INNER JOIN Buch ON buch.bID = buch.BID
WHERE Exemplar.eStatus = 'verfuegbar'
ORDER BY Exemplar.eStandort DESC;

--18. Geben Sie alle Ausleihen mit Vor und Nachname des Mitglieds und dem Standort des
--Exemplars aus. Sortieren Sie nach Ausleihdatum aufsteigend.
Select Ausleihe.*, Mitglied.mNachname, Mitglied.mVorname, Exemplar.eStandort 
From ausleihe
INNER JOIN Mitglied ON Mitglied.MID = Ausleihe.mID
INNER JOIN Exemplar ON Exemplar.EID = Ausleihe.eID;

--19 Geben Sie alle Exemplare mit Buchtitel, Genre und Autor aus, deren Status NICHT
--„verfügbar“ ist und sortieren Sie diese aufsteigend nach Buchtitel.
SELECT Buch.bTitle, buch.bGenre, autor.aVorname, autor.aNachname, exemplar.eStandort, exemplar.eStatus
FROM Exemplar 
INNER JOIN Buch ON Exemplar.bID = Buch.BID
INNER JOIN Autor ON Buch.aID = autor.AID
WHERE Exemplar.eStatus != 'verfuegbar'
ORDER BY Buch.bTitle ASC;

--20 Geben Sie Buchtitel, Autorennachnamen und Standort all jener Exemplare aus, die
--„verfügbar“ sind und deren Autor aus der UK ist.
SELECT Buch.bTitle, Autor.aNachname, Exemplar.eStandort
FROM Exemplar
INNER JOIN Buch ON Exemplar.bID = Buch.BID
INNER JOIN Autor ON Buch.aID = Autor.AID
WHERE Exemplar.eStatus = 'verfuegbar'AND Autor.aCountry = 'UK';

