--JOINS + Aggregatfunktionen

--1. Geben Sie Standort, Buchtitel, FSK und den Nachnamen des Autors von allen derzeitig
--ausgeliehenden Büchern aus, deren Autor ein ‚e‘ im Nachnamen hat.

Select Exemplar.eStandort,Buch.bFsk,  autor.aNachname, Autor.aCountry From Buch
INNER JOIN Exemplar on Exemplar.bID == Buch.BID
INNER JOIN Autor on Autor.AID == Buch.BID;

--2. Geben Sie die das Genre und die Anzahl der Autoren aller Bücher mit dem gleichen
--Genre aus, absteigend sortiert nach Nachname des Au
SELECT Buch.bGenre, count(Autor.AID) AS CountAutor From Buch
INNER JOIN Autor on Autor.AID == Buch.aID
Group by Buch.bGenre;
--3
Select Buch.bTitle, Buch.bJahr, Autor.aNachname, Autor.aVorname, min(Buch.bJahr) FROM Buch
INNER JOIN Autor on Buch.aID == Autor.AID;

