--17. Geben Sie für jedes Mitgliedsalter den alphabetisch letzten Nachnamen eines Mitglieds
--dieses Alters aus.
SELECT Mitglied.mAlter, max(Mitglied.mNachname) as LastLastname FROM Mitglied
GROUP BY Mitglied.mAlter;

--18. Geben Sie für jedes Country die Summe der FSK-Werte aller Bücher aus, die von Autoren
--dieses Landes verfasst wurden, sortiert absteigend nach der Summe
SELECT Autor.aCountry, sum(Buch.bFsk) as SumFSK FROM AUtor
INNER JOIN Buch on Buch.aID = Autor.AID
GROUP by Autor.aCountry
ORDER BY  sumFSK desc;

--19. Geben Sie für jeden Autor den Vor- und Nachnamen sowie die Anzahl der offenen
--Ausleihen seiner Bücher aus.
SELECT Autor.aNachname, AUtor.aVorname, count(Ausleihe.AID) FROM Autor
INNER JOIN Ausleihe on Autor.AID = Ausleihe.AID
LEFT JOIN Buch on Autor.AID = Buch.BID
WHERE Ausleihe.aRueckgabe is NULL
GROUP by Autor.AID;
