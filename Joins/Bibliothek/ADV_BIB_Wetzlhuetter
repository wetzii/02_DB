--11. Geben Sie alle Mitglieder mit Vor- und Nachname aus, die mehr als eine Ausleihe
--getätigt haben. Es soll auch die Anzahl der Ausleihen angezeigt wer
Select Mitglied.mVorname, Mitglied.mNachname, count(Ausleihe.AID) as AnzahlAusleihe FROM Mitglied
INNER JOIN Ausleihe on Ausleihe.mID = Mitglied.MID
Group by Mitglied.MID
HAVING AnzahlAusleihe > 1;

--12
--12. Geben Sie alle Bücher mit Buchtitel, Genre und Autorennamen aus, zu denen kein
--Exemplar existiert.
SELECT Buch.bTitle, Buch.bGenre, Autor.aNachname FROM BUCH 
INNER JOIN Buch on Buch.BID = Autor.AID
LEFT JOIN Buch on Buch.BID = Exemplar.bID
WHERE Exemplar.EID is NULL;

--13. Geben Sie für jedes Genre die Anzahl aller Bücher ohne Autor aus. Es sollen Genre und
--Anzahl ausgegeben werden.
SELECT Buch.bGenre, Count(*) FROM BUCH 
LEFT Join Autor ON Buch.aID = Autor.AID
WHERE Autor.AID is NULL
Group by Buch.bGenre;

--14. Geben Sie für jedes Genre den kleinsten FSK-Wert aus, aber nur für jene Genres, in
--denen mehr als ein Buch vorhanden ist
SElect Buch.bGenre, min(Buch.bFsk) as minFSK FROM Buch
GROUP by Buch.bGenre
HAving count(*) > 1;

--15. Geben Sie für jedes Genre das neueste Erscheinungsjahr aus, aber nur für jene Genres,
--deren durchschnittlicher FSK größer als 10 ist.
SELECT Buch.bGenre, max(Buch.bJahr) FROM BUCH
GROUP by Buch.bGenre
HAVING avg(Buch.bFsk) > 10;

--16. Geben Sie für jedes Alter der Mitglieder die Anzahl der Ausleihen aus, die von Mitglie-
--dern dieses Alters getätigt wurden. Es sollen nur Altersgruppen mit mehr als einer
--Ausleihe angezeigt werden.
SELECT Mitglied.mAlter, count(*) as avgAusleihen FROM Mitglied
INNER JOIN ausleihe on Ausleihe.mID = Mitglied.MID
GROUP BY Mitglied.mAlter
HAVING count(*) > 1;
